# Minimal standalone configuration.
# Copy to .env beside docker-compose.yml, or set these values in the compose file.

UI_HOSTNAME=oxidized.example.com
UI_HTTP_PORT=80
UI_HTTPS_PORT=443

# Optional advanced settings can be added below. See the README table.
# Examples:
# TZ=UTC
# DEFAULT_LANGUAGE=en
# METRICS_TOKEN=
# INBOUND_WEBHOOK_TOKEN=
# OIDC_ENABLED=false
