# Single-container Oxidized UI. Copy to .env and edit.
TZ=UTC
DEFAULT_LANGUAGE=es
UI_HOSTNAME=oxidized.example.com
UI_DOMAIN=oxidized.local
UI_HTTP_PORT=80
UI_HTTPS_PORT=443

SECRET_KEY=CHANGE_ME_use_a_random_48_byte_urlsafe_string
FERNET_KEY=CHANGE_ME_use_Fernet_generate_key
OXIDIZED_SOURCE_TOKEN=CHANGE_ME_use_a_different_random_48_byte_urlsafe_string

# Optional first-run admin. Leave empty to use the setup wizard.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_LANGUAGE=es

# Optional /api/metrics bearer token.
METRICS_TOKEN=
UI_LOG_LEVEL=INFO

# Optional inbound webhook token for POST /api/hooks/backup
INBOUND_WEBHOOK_TOKEN=

# Optional generic OIDC login
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://oxidized.example.com/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_DEFAULT_ROLE=viewer
OIDC_AUTO_CREATE=true
