# Single-container Oxidized UI. Copy to .env and edit.
TZ=UTC
DEFAULT_LANGUAGE=en
UI_HOSTNAME=oxidized.example.com
UI_DOMAIN=oxidized.local
UI_HTTP_PORT=80
UI_HTTPS_PORT=443

# Leave these empty to generate and persist them automatically on first start.
# Set them explicitly when reusing an existing database.
SECRET_KEY=
FERNET_KEY=
OXIDIZED_SOURCE_TOKEN=

# Optional first-run admin. Leave empty to use the setup wizard.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_LANGUAGE=en

# Optional /api/metrics bearer token.
METRICS_TOKEN=
UI_LOG_LEVEL=INFO

# Optional inbound webhook token for POST /api/hooks/backup
INBOUND_WEBHOOK_TOKEN=

# Optional generic OIDC login
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://oxidized.example.com/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_DEFAULT_ROLE=viewer
OIDC_AUTO_CREATE=true

# 0 = keep all configuration backups
CONFIG_BACKUP_KEEP=0
