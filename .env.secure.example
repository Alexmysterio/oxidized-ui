# Secure four-container deployment.
# Copy to .env and replace every CHANGE_ME value before starting.

OXIDIZED_IMAGE=oxidized/oxidized:0.37.0
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.5.0

# Published ports and public hostname.
UI_BIND_ADDRESS=127.0.0.1
UI_PORT=8080
UI_HOSTNAME=oxidized.example.com
UI_HTTP_PORT=80
UI_HTTPS_PORT=443
TZ=UTC
DEFAULT_LANGUAGE=en

# Required application secrets. Generate random values with the commands in
# the README and keep FERNET_KEY safe.
SECRET_KEY=CHANGE_ME_random_48_byte_urlsafe_string
FERNET_KEY=CHANGE_ME_Fernet_key
OXIDIZED_SOURCE_TOKEN=CHANGE_ME_different_random_48_byte_urlsafe_string

# Internal service names and URLs.
OXIDIZED_CONTAINER_NAME=oxidized
OXIDIZED_API_URL=http://oxidized:8888
DOCKER_PROXY_URL=http://docker-socket-proxy:2375
UI_INTERNAL_URL=http://oxidized-ui:8080

# Browser security.
SESSION_COOKIE_SECURE=true
TRUSTED_ORIGINS=https://oxidized.example.com
TRUST_PROXY_HEADERS=true

# Optional first-run administrator. Leave empty to use the setup wizard.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_LANGUAGE=en

# Optional integrations.
METRICS_TOKEN=
CONFIG_BACKUP_KEEP=0
UI_LOG_LEVEL=INFO
